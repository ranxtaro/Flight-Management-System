<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="Lab1_OOP_Bradul.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Flight Manager">

    <Grid
        x:Name="RootGrid"
        Loaded="RootGrid_Loaded"
        Background="#F6F8FC"
        RequestedTheme="Light">

        <Grid Padding="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->

            <Grid>

                <StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">

                        <Border
                            Width="42"
                            Height="42"
                            Background="#E7F1FF"
                            CornerRadius="13">

                            <TextBlock
                                Text="✈"
                                FontSize="21"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock
                            Text="Flight Manager"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="#1E293B"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                    

                </StackPanel>


                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">

                    <TextBlock
                        x:Name="FlightLimitText"
                        Text="Limit: not set"
                        Foreground="#8492A6"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>

                    <Button
                        x:Name="DeleteFlightButton"
                        Click="DeleteFlightButton_Click"
                        Height="44"
                        Padding="18,0"
                        Background="#FFF0F1"
                        Foreground="#B65B63"
                        BorderThickness="0"
                        CornerRadius="12"
                        IsEnabled="False"
                        Content="Delete"/>

                    <Button
                        x:Name="AddFlightButton"
                        Click="AddFlightButton_Click"
                        Height="44"
                        Padding="20,0"
                        Background="#6EA8E6"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="12"
                        FontWeight="SemiBold"
                        IsEnabled="False"
                        Content="＋  Add flight"/>

                    <Button
                        x:Name="ExitButton"
                        Click="ExitButton_Click"
                        Height="44"
                        Padding="16,0"
                        Background="#EEF1F5"
                        Foreground="#64748B"
                        BorderThickness="0"
                        CornerRadius="12"
                        Content="Exit"/>

                </StackPanel>

            </Grid>


            <!-- SEARCH -->

            <Border
                Grid.Row="1"
                Margin="0,26,0,18"
                Padding="16"
                Background="White"
                CornerRadius="16">

                <Grid ColumnSpacing="12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        x:Name="SearchFieldComboBox"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="0">

                        <ComboBoxItem Content="Flight number"/>
                        <ComboBoxItem Content="Destination"/>

                    </ComboBox>

                    <TextBox
                        x:Name="SearchTextBox"
                        Grid.Column="1"
                        PlaceholderText="Enter search value..."/>

                    <Button
                        x:Name="SearchButton"
                        Click="SearchButton_Click"
                        Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        Background="#EEF4FB"
                        Foreground="#4776A8"
                        BorderThickness="0"
                        CornerRadius="10"
                        Content="Search"/>

                </Grid>

            </Border>


            <!-- MAIN -->

            <Grid
                Grid.Row="2"
                ColumnSpacing="18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>


                <!-- FLIGHT LIST -->

                <Border
                    Grid.Column="0"
                    Background="White"
                    CornerRadius="18"
                    Padding="22">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <Grid>

                            <StackPanel>

                                <TextBlock
                                    Text="Flights"
                                    FontSize="21"
                                    FontWeight="SemiBold"
                                    Foreground="#1E293B"/>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="All objects of the Flight class"
                                    FontSize="13"
                                    Foreground="#8A97A8"/>

                            </StackPanel>

                            <TextBlock
                                x:Name="FlightCountText"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Text="0 flights"
                                FontSize="13"
                                Foreground="#8A97A8"/>

                        </Grid>


                        <!-- TABLE HEADER -->

                        <Grid
                            Grid.Row="1"
                            Margin="0,22,0,7"
                            Padding="8,11"
                            Background="#F7F9FC"
                            CornerRadius="10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="35"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="#"
                                FontSize="10"
                                Foreground="#94A3B8"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="FLIGHT"
                                FontSize="10"
                                Foreground="#94A3B8"/>

                            <TextBlock
                                Grid.Column="2"
                                Text="DESTINATION"
                                FontSize="10"
                                Foreground="#94A3B8"/>

                            <TextBlock
                                Grid.Column="3"
                                Text="DEPARTURE"
                                FontSize="10"
                                Foreground="#94A3B8"/>

                            <TextBlock
                                Grid.Column="4"
                                Text="PASSENGERS"
                                FontSize="10"
                                Foreground="#94A3B8"/>

                            <TextBlock
                                Grid.Column="5"
                                Text="PRICE"
                                FontSize="10"
                                Foreground="#94A3B8"/>

                            <TextBlock
                                Grid.Column="6"
                                Text="TYPE"
                                FontSize="10"
                                Foreground="#94A3B8"/>

                            <TextBlock
                                Grid.Column="7"
                                Text="STATUS"
                                FontSize="10"
                                Foreground="#94A3B8"/>

                        </Grid>


                        <!-- LIST -->

                        <Grid Grid.Row="2">

                            <ListView
                                x:Name="FlightsListView"
                                SelectionMode="Single"
                                SelectionChanged="FlightsListView_SelectionChanged"/>


                            <StackPanel
                                x:Name="EmptyFlightsPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="7">

                                <Border
                                    Width="56"
                                    Height="56"
                                    Background="#EEF5FD"
                                    CornerRadius="18"
                                    HorizontalAlignment="Center">

                                    <TextBlock
                                        Text="✈"
                                        FontSize="25"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock
                                    x:Name="EmptyFlightsTitleText"
                                    Margin="0,8,0,0"
                                    Text="No flights yet"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="#475569"
                                    HorizontalAlignment="Center"/>

                                <TextBlock
                                    x:Name="EmptyFlightsSubtitleText"
                                    Text="Add your first flight to get started"
                                    FontSize="13"
                                    Foreground="#94A3B8"
                                    HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>


                <!-- SELECTED FLIGHT -->

                <Border
                    Grid.Column="1"
                    Background="White"
                    CornerRadius="18"
                    Padding="22">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <StackPanel Spacing="18">

                            <StackPanel>

                                <TextBlock
                                    Text="Selected flight"
                                    FontSize="21"
                                    FontWeight="SemiBold"
                                    Foreground="#1E293B"/>

                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="Select a flight from the table"
                                    FontSize="13"
                                    Foreground="#8A97A8"/>

                            </StackPanel>


                            <StackPanel>
                                <TextBlock Text="Flight number" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="SelectedFlightNumberText" Text="-" FontSize="17" FontWeight="SemiBold" Foreground="#334155"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Destination" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="SelectedDestinationText" Text="-" Foreground="#475569"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Departure" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="SelectedDepartureText" Text="-" Foreground="#475569"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Passengers" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="SelectedPassengersText" Text="-" Foreground="#475569"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Ticket price" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="SelectedPriceText" Text="-" Foreground="#475569"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Flight type" FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock x:Name="SelectedTypeText" Text="-" Foreground="#475569"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Status" FontSize="11" Foreground="#94A3B8"/>

                                <Border
                                    Margin="0,4,0,0"
                                    Padding="10,5"
                                    Background="#EEF4FB"
                                    CornerRadius="10"
                                    HorizontalAlignment="Left">

                                    <TextBlock
                                        x:Name="SelectedStatusText"
                                        Text="Not selected"
                                        FontSize="12"
                                        Foreground="#64809F"/>

                                </Border>

                            </StackPanel>


                            <Border
                                Height="1"
                                Background="#EEF1F5"
                                Margin="0,4,0,2"/>


                            <TextBlock
                                Text="Class methods"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#64748B"/>


                            <Button
                                x:Name="AddPassengerButton"
                                Click="AddPassengerButton_Click"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                Background="#EEF7F2"
                                Foreground="#50836A"
                                BorderThickness="0"
                                CornerRadius="10"
                                IsEnabled="False"
                                Content="＋  Add passenger"/>

                            <Button
                                x:Name="DelayFlightButton"
                                Click="DelayFlightButton_Click"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                Background="#FFF7E8"
                                Foreground="#A17732"
                                BorderThickness="0"
                                CornerRadius="10"
                                IsEnabled="False"
                                Content="Delay flight"/>

                            <Button
                                x:Name="StartBoardingButton"
                                Click="StartBoardingButton_Click"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                Background="#EDF4FF"
                                Foreground="#4D78AD"
                                BorderThickness="0"
                                CornerRadius="10"
                                IsEnabled="False"
                                Content="Start boarding"/>

                            <Button
                                x:Name="CancelFlightButton"
                                Click="CancelFlightButton_Click"
                                Height="40"
                                HorizontalAlignment="Stretch"
                                Background="#FFF0F1"
                                Foreground="#B65B63"
                                BorderThickness="0"
                                CornerRadius="10"
                                IsEnabled="False"
                                Content="Cancel flight"/>

                        </StackPanel>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>